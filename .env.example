# Copy to .env and fill in. .env is ignored by git; never put keys in this file.

# Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Qwen3.5-27B on vLLM at Kadaster (OpenAI-compatible); address and model name to follow
# Use: --model openai-api/kadaster/<model-name>
KADASTER_BASE_URL=
KADASTER_API_KEY=

# Local OpenAI-compatible endpoint for the connection test, for example Ollama
# Use: --model openai-api/local/<model-name>
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama

# Optional: another price file than model-costs.yaml in the repo root
# AIRCO_MODEL_COSTS=model-costs.yaml

# Models for airco-matrix when --models is not given, comma-separated
AIRCO_MATRIX_MODELS=

# Log folder
INSPECT_LOG_DIR=logs
