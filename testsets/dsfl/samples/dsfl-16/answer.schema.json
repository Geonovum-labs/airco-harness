{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buurten": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "naam": {"type": "string"},
          "verhard": {"type": "number"},
          "klei": {"type": "number"},
          "score": {"type": "number"},
          "boorkolom": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "top": {"type": "number"},
                "basis": {"type": "number"},
                "lithoklasse": {"type": "string"},
                "kans_klei": {"type": "number"}
              },
              "required": ["top", "basis", "lithoklasse", "kans_klei"]
            }
          }
        },
        "required": ["code", "naam", "verhard", "klei", "score", "boorkolom"]
      }
    }
  },
  "required": ["buurten"],
  "additionalProperties": true
}
