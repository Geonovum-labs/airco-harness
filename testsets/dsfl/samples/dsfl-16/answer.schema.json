{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buurten": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "naam": {"type": "string"},
          "verhard": {"type": "number"},
          "klei": {"type": "number"},
          "score": {"type": "number"}
        },
        "required": ["code", "naam", "verhard", "klei", "score"]
      }
    }
  },
  "required": ["buurten"],
  "additionalProperties": true
}
