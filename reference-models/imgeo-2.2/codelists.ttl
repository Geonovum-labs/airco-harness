    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_groenvoorziening ;
    skos:definition "Beheerde niet nader gespecificeerde beplanting van groenvak in de openbare ruimte."@nl ;
    skos:exactMatch begrip:Planten_fysiekVoorkomenBegroeidTerreinPlus ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "planten"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_struikrozen a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_groenvoorziening ;
