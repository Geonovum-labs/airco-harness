    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_bouwland ;
    skos:definition "Terreindeel in gebruik als akker, voor de teelt van bloembollen."@nl ;
    skos:exactMatch begrip:Bollenteelt ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "bollenteelt"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_bosplantsoen a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_groenvoorziening ;
    skos:definition "Opgaande beplanting van houtachtige gewassen die struikvormend en/of boomvormend zijn. De soorten zijn als bosplantsoen opgekweekt en aangeplant.De beplanting kan open of gesloten zijn en bestaat vaak uit inheemse soorten. Onderscheidt zich van heesters omdat de sierkenmerken niet voorop staan."@nl ;
    skos:exactMatch begrip:Bosplantsoen_fysiekVoorkomenBegroeidTerreinPlus ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "bosplantsoen"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_braakliggend a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_bouwland ;
    skos:definition "Terrein in gebruik als akker, maar tijdelijk niet beteeld met een landbouwgewas."@nl ;
    skos:exactMatch begrip:Braakliggend ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "braakliggend"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_gesloten_duinvegetatie a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_duin ;
    skos:definition "Duin met een overwegend opgaande vegetatie van struiken en of bomen."@nl ;
    skos:exactMatch begrip:GeslotenDuinvegetatie ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "gesloten duinvegetatie"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_gras-_en_kruidachtigen a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_groenvoorziening ;
    skos:definition "(Grond met) een laagblijvende, aaneengesloten kruidachtige vegetatie."@nl ;
    skos:exactMatch begrip:Gras-EnKruidachtigen_fysiekVoorkomenBegroeidTerreinPlus ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
