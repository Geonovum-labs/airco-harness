    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_griend_en_hakhout a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_loofbos ;
    skos:definition "Terreindeel met opgaande begroeiing van loofbomen, in een dicht groeiverband, en die periodiek wordt afgezet."@nl ;
    skos:exactMatch begrip:GriendEnHakhout ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "griend en hakhout"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_heesters a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_groenvoorziening ;
    skos:definition "Beplanting van houtige gewassen die struikvormend zijn en die al dan niet een gesloten geheel vormen. Het accent ligt op de sierwaarde, de beplanting kan uit één soort of uit meerdere soorten bestaan. Onder de heesters kan een houtachtige of kruidachtige onderbegroeiing aanwezig zijn. Het oppervlak met struikachtige gewassen is meer dan 50% van de totale oppervlakte van het vak."@nl ;
    skos:exactMatch begrip:Heesters_fysiekVoorkomenBegroeidTerreinPlus ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "heesters"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_hoogstam_boomgaarden a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_fruitteelt ;
    skos:definition "Terreindeel begroeid met hoogstamfruitbomen."@nl ;
    skos:exactMatch begrip:HoogstamBoomgaarden ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "hoogstam boomgaarden"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

