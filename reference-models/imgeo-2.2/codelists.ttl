    skos:definition "Wegdeel waar de verblijfsfunctie (lopen, spelen, ontmoeten enzovoorts) prioriteit heeft boven de verkeersfunctie."@nl ;
    skos:exactMatch begrip:Woonerf ;
    skos:inScheme airco:list_FunctieWeg ;
    skos:prefLabel "woonerf"@nl ;
    skos:topConceptOf airco:list_FunctieWeg .

airco:FysiekVoorkomenBegroeidTerreinPlus_akkerbouw a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_bouwland ;
    skos:definition "Terreindeel in gebruik als akker, voor de teelt van akkerbouwgewassen."@nl ;
    skos:exactMatch begrip:Akkerbouw ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "akkerbouw"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerreinPlus_bodembedekkers a skos:Concept ;
    skos:broadMatch airco:FysiekVoorkomenBegroeidTerrein_groenvoorziening ;
    skos:definition "Beheerde beplanting van groenvak in  de openbare ruimte, zijnde bodembedekkers."@nl ;
    skos:exactMatch begrip:Bodembedekkers_fysiekVoorkomenBegroeidTerreinPlus ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "bodembedekkers"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

