    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerreinPlus ;
    skos:prefLabel "wijngaarden"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerreinPlus .

airco:FysiekVoorkomenBegroeidTerrein_boomteelt a skos:Concept ;
    skos:definition "Grond in gebruik voor het kweken van jonge siergewassen, bomen enz. ten behoeve van een later gebruik elders."@nl ;
    skos:exactMatch begrip:Boomteelt ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerrein ;
    skos:prefLabel "boomteelt"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerrein .

airco:FysiekVoorkomenBegroeidTerrein_gemengd_bos a skos:Concept ;
    skos:definition "Terreindeel begroeid met een dusdanige aantal naald- en loofbomen dat deze een min of meer gesloten geheel vormen of, na volgroeiing van de bomen, zullen vormen."@nl ;
    skos:exactMatch begrip:GemengdBos ;
    skos:inScheme airco:list_FysiekVoorkomenBegroeidTerrein ;
    skos:notation "BGT" ;
    skos:prefLabel "gemengd bos"@nl ;
    skos:topConceptOf airco:list_FysiekVoorkomenBegroeidTerrein .

